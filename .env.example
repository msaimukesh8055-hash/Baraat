# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — NEVER commit real secrets. This template (names only) is safe to commit.

# --- Model backend for the extractor ---
# Groq Cloud (https://console.groq.com) serves open models via an OpenAI-compatible API.
GROQ_API_KEY=your-groq-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# (Optional, later) If/when switching the backend to Anthropic Claude:
# ANTHROPIC_API_KEY=your-anthropic-key-here
